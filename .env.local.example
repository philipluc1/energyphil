# Copy this file to .env.local for local development, and set the same
# values in Vercel: Project Settings > Environment Variables.
#
# Get these from Supabase: Project Settings > API.
# The publishable key is safe to expose in the browser — it can only do what
# the Row Level Security policies in supabase/schema.sql allow (insert-only
# into "leads"). Never put the secret key here or in NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — powers the private /dashboard analytics page. This key
# bypasses Row Level Security, so it must NOT have the NEXT_PUBLIC_ prefix
# (that would ship it to the browser). Get it from Supabase: Project
# Settings > API > Secret keys.
SUPABASE_SECRET_KEY=

# Whatever password you want to use to view /dashboard. Pick your own value —
# this isn't a Supabase setting, just a password this app checks itself.
DASHBOARD_PASSWORD=

# Server-only — powers the "take a photo of your bill" feature. Get this from
# console.anthropic.com (Anthropic's developer console — create an account,
# add a payment method, then Settings > API Keys). Costs a small amount per
# bill photo scanned. Leave blank to keep that feature switched off; the site
# still works fine with manual entry only.
ANTHROPIC_API_KEY=

# Server-only — powers the paid "ongoing monitoring" subscription checkout.
# Get both from the Stripe Dashboard for the Stripe account you use for THIS
# business (see README for why that should be its own account, separate from
# any other business you already have on Stripe).
#   STRIPE_SECRET_KEY: Developers > API keys > Secret key.
#   STRIPE_WEBHOOK_SECRET: Developers > Webhooks > add an endpoint pointing at
#     https://<your-site>/api/stripe-webhook listening for checkout.session.completed,
#     customer.subscription.updated and customer.subscription.deleted — then
#     copy the "Signing secret" it gives you.
# Leave both blank to keep the pricing/checkout buttons quietly disabled;
# the free comparator still works fully without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server-only — powers the automatic "a cheaper plan showed up" alert emails
# (both for paying subscribers and for free leads who ticked the "tell me
# about cheaper plans" box). Sign up free at https://resend.com, create an
# API key (Settings > API Keys), and put it here.
#   RESEND_API_KEY: required to send any alert emails at all.
#   RESEND_FROM_ADDRESS: optional. Until you verify your own sending domain in
#     Resend (Domains > Add Domain), leave this blank — it defaults to
#     Resend's shared "onboarding@resend.dev" address, which can only
#     actually deliver to the email you signed up to Resend with (that's a
#     Resend sandbox limit, for testing). Once you verify a domain, set this
#     to something like "VIC Energy Check <alerts@yourdomain.com>".
# Leave RESEND_API_KEY blank to keep the recheck job switched off; nothing
# else breaks.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Server-only — locks down the daily price-recheck job (see vercel.json) so
# only Vercel's own Cron scheduler can trigger it, not just anyone who finds
# the URL. Pick any long random value yourself (e.g. generate one at
# https://www.uuidgenerator.net) and set the same value here and in Vercel.
# Leave blank while testing locally; set it before you rely on this live.
CRON_SECRET=
